APP_NAME=Helm
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Personal tenant console. OAuth credentials stay private on this host.
HELM_WEB_ENABLED=false
# Direct WSS uses canonical HTTPS APP_URL; no Node gateway secret is required.
# Keep legacy settings only for a deliberate rollback deployment.
HELM_WEB_LEGACY_GATEWAY_ENABLED=false
# Four Stripe subscription Payment Links and their recurring Price IDs.
# Keep false until all fields are configured and existing Vessel priorities reviewed.
HELM_BILLING_ENABLED=false
HELM_STRIPE_LIVE_MODE=false
HELM_STRIPE_WEBHOOK_SECRET=
HELM_STRIPE_PORTAL_URL=
HELM_STRIPE_BASIC_MONTH_URL=
HELM_STRIPE_BASIC_MONTH_LINK_ID=
HELM_STRIPE_BASIC_MONTH_PRICE_ID=
HELM_STRIPE_BASIC_YEAR_URL=
HELM_STRIPE_BASIC_YEAR_LINK_ID=
HELM_STRIPE_BASIC_YEAR_PRICE_ID=
HELM_STRIPE_PRO_MONTH_URL=
HELM_STRIPE_PRO_MONTH_LINK_ID=
HELM_STRIPE_PRO_MONTH_PRICE_ID=
HELM_STRIPE_PRO_YEAR_URL=
HELM_STRIPE_PRO_YEAR_LINK_ID=
HELM_STRIPE_PRO_YEAR_PRICE_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Microsoft: personal and work/school accounts, Web callback /auth/microsoft/callback.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
